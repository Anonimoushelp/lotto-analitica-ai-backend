# Configuración de Lotto Analítica AI
# Copiar este archivo como .env y completar los valores reales

DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@localhost:5432/lotto_analitica
SECRET_KEY=GENERAR_UN_SECRETO_ALEATORIO_LARGO

GEMINI_API_KEY=TU_CLAVE_GEMINI

APP_URL=http://localhost:3000

# Solo habilitar temporalmente para crear el primer usuario administrador.
# Volver a false inmediatamente después del bootstrap.
ALLOW_INITIAL_REGISTRATION=false

# En producción, usar los hostnames reales del API, separados como lista JSON.
# Ejemplo: ["api.example.com"]
TRUSTED_HOSTS=["localhost"]
